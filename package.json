{
  "name": "ardalanamini.com",
  "version": "1.0.0",
  "private": true,
  "description": "My Personal Portfolio",
  "license": "MIT",
  "author": "Ardalan Amini <ardalanamini22@gmail.com> (https://ardalanamini.com)",
  "homepage": "https://ardalanamini.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardalanamini/ardalanamini.com.git"
  },
  "bugs": {
    "url": "https://github.com/ardalanamini/ardalanamini.com/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "vite --open --mode ssr",
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-workers/vite.config.ts && node scripts/build-markdown.mjs",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "lint": "oxlint",
    "lint:fix": "pnpm lint --fix",
    "preview": "qwik build preview && vite preview --open",
    "serve": "wrangler dev",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "qwik": "qwik",
    "knip": "knip",
    "prepare": "is-ci || lefthook install"
  },
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@builder.io/qwik": "1.20.2",
    "@builder.io/qwik-city": "1.20.2",
    "@qwik.dev/partytown": "1.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "eslint-plugin-qwik": "1.20.2",
    "is-ci": "4.1.0",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "mdast-util-to-markdown": "2.2.0",
    "oxlint": "1.89.0",
    "oxlint-config-noir": "1.0.8",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wrangler": "4.151.3"
  }
}
